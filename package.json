{
  "name": "task-tracker-root",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup:db": "docker compose -f backend/docker-compose.yaml up -d",
    "setup:backend": "npx --prefix backend prisma db push && npm --prefix backend run seed",
    "setup": "npm run setup:db && npm run setup:backend",
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend run dev",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend"
  }
}
